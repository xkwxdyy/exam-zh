\NeedsTeXFormat{LaTeX2e}

\RequirePackage{expl3}

\ProvidesExplPackage {exam-zh-english} {2026-08-21} {v0.3.8}
  {exam-zh English module}

\PassOptionsToPackage { most } { tcolorbox }
\RequirePackage { tcolorbox }

% 作文框
\NewDocumentEnvironment { writingbox } { O{ } +b }
  {
    \begin{tcolorbox}
      [
        % 直角
        sharp~corners = all,
        % 颜色
        colback = white,
        colbacktitle = white,
        % colframe = white,
        coltitle = black,
        % 边框粗细
        boxrule   = 1pt,
        titlerule = 0pt,
        % 间距
        toptitle  = 4pt,
        % 字体
        fonttitle = \centering,
        % 首行缩进
        parbox  = false,
        before~upper = \indent,
        % 跨页
        breakable,
        enhanced~jigsaw,
        #1
      ]
      #2
  }
  {
    \end{tcolorbox}
  }

% 英语作文横线框
\int_new:N \l__examzh_writing_lines_count_int
\tl_new:N \l__examzh_writing_line_width_tl
\tl_new:N \l__examzh_writing_line_height_tl
\tl_new:N \l__examzh_writing_line_thickness_tl
\tl_new:N \l__examzh_writing_line_color_tl
\tl_new:N \l__examzh_writing_box_options_tl
\dim_new:N \l__examzh_writing_line_width_dim
\dim_new:N \l__examzh_writing_line_height_dim
\dim_new:N \l__examzh_writing_line_thickness_dim
\dim_new:N \l__examzh_writing_line_sep_dim

\keys_define:nn { exam-zh / writing-lines }
  {
    line-width .tl_set:N = \l__examzh_writing_line_width_tl,
    line-height .tl_set:N = \l__examzh_writing_line_height_tl,
    line-thickness .tl_set:N = \l__examzh_writing_line_thickness_tl,
    line-color .tl_set:N = \l__examzh_writing_line_color_tl,
    box-options .tl_set:N = \l__examzh_writing_box_options_tl
  }

\keys_set:nn { exam-zh / writing-lines }
  {
    line-width     = \linewidth,
    line-height    = 1.8\baselineskip,
    line-thickness = 0.4pt,
    line-color     = black,
    box-options    =
  }

\msg_new:nnn { exam-zh / english } { writing-lines-invalid-count }
  { The~writing~line~count~must~be~positive. }

\cs_new_protected:Npn \__examzh_writing_lines_prepare:
  {
    \dim_set:Nn \l__examzh_writing_line_width_dim
      { \l__examzh_writing_line_width_tl }
    \dim_set:Nn \l__examzh_writing_line_height_dim
      { \l__examzh_writing_line_height_tl }
    \dim_set:Nn \l__examzh_writing_line_thickness_dim
      { \l__examzh_writing_line_thickness_tl }
    \dim_set:Nn \l__examzh_writing_line_sep_dim
      {
        \l__examzh_writing_line_height_dim
        - \l__examzh_writing_line_thickness_dim
      }
  }

\NewDocumentCommand \writingline { O{ } }
  {
    \group_begin:
      \keys_set:nn { exam-zh / writing-lines } {#1}
      \__examzh_writing_lines_prepare:
      \par
      { \color { \l__examzh_writing_line_color_tl }
        \hrule
          height \dim_use:N \l__examzh_writing_line_thickness_dim
          width  \dim_use:N \l__examzh_writing_line_width_dim }
      \dim_compare:nNnT
        { \l__examzh_writing_line_sep_dim } > { 0pt }
        { \vskip \dim_use:N \l__examzh_writing_line_sep_dim }
    \group_end:
  }

\NewDocumentCommand \writinglines { O{ } m }
  {
    \group_begin:
      \keys_set:nn { exam-zh / writing-lines } {#1}
      \__examzh_writing_lines_prepare:
      \int_set:Nn \l__examzh_writing_lines_count_int {#2}
      \int_compare:nNnTF
        { \l__examzh_writing_lines_count_int } > { 0 }
        {
          \begin{tcolorbox}
            [
              sharp~corners = all,
              colback = white,
              boxrule = 1pt,
              breakable,
              enhanced~jigsaw,
              boxsep = 0pt,
              left = 0pt,
              right = 0pt,
              top = 2pt,
              bottom = 2pt,
              before~upper = { \parindent = 0pt \parskip = 0pt },
              \l__examzh_writing_box_options_tl
            ]
            \int_compare:nNnTF
              { \l__examzh_writing_lines_count_int } > { 1 }
              {
                \vskip \dim_use:N \l__examzh_writing_line_sep_dim
                \int_step_inline:nn
                  { \l__examzh_writing_lines_count_int - 1 }
                  { \writingline }
              }
              { \vskip \dim_use:N \l__examzh_writing_line_height_dim }
            \nointerlineskip
            \hbox{}
          \end{tcolorbox}
        }
        { \msg_error:nn { exam-zh / english } { writing-lines-invalid-count } }
    \group_end:
  }

\endinput
