\documentclass{article}

\input{regression-test}

\usepackage{exam-zh-question}
\usepackage{exam-zh-textfigure}

\begin{document}
\START

\ExplSyntaxOn

\keys_set:nn { exam-zh / paren } { type = hfill }
\bool_if:NTF \l__examzh_paren_type_hfill_bool
  { \TYPE{paren-hfill=true} }
  { \TYPE{paren-hfill=false} }
\bool_if:NTF \l__examzh_paren_type_dotfill_bool
  { \TYPE{paren-dotfill=true} }
  { \TYPE{paren-dotfill=false} }

\keys_set:nn { exam-zh / paren } { type = dotfill }
\bool_if:NTF \l__examzh_paren_type_hfill_bool
  { \TYPE{dotfill-hfill=true} }
  { \TYPE{dotfill-hfill=false} }
\bool_if:NTF \l__examzh_paren_type_dotfill_bool
  { \TYPE{dotfill-enabled=true} }
  { \TYPE{dotfill-enabled=false} }

\keys_set:nn { exam-zh / paren } { type = none }
\bool_if:NTF \l__examzh_paren_type_hfill_bool
  { \TYPE{none-hfill=true} }
  { \TYPE{none-hfill=false} }
\bool_if:NTF \l__examzh_paren_type_dotfill_bool
  { \TYPE{none-dotfill=true} }
  { \TYPE{none-dotfill=false} }

\keys_set:nn { exam-zh / multifigures } { column-gap = 12pt }
\TYPE{multifigures-column-gap=\dim_use:N \l__examzh_multifigures_column_gap_dim}

\cs_new_protected:Npn \examzhtestmultifigureswidth #1#2
  {
    \dim_compare:nNnTF
      { \l__examzh_multifigures_item_width_dim } = {#1}
      { \TYPE{#2=true} }
      { \TYPE{#2=false} }
  }

\ExplSyntaxOff

\ExplSyntaxOn
\keys_set:nn { exam-zh / paren } { type = dotfill }
\ExplSyntaxOff
\par Text before a dotted answer leader.\paren

\begin{multifigures}[columns=2,column-gap=12pt][colspec={*{2}{X[c]}}]
  \examzhtestmultifigureswidth
    { ( \linewidth - 24pt ) / 2 }
    {multifigures-item-width}
  \item \rule{\linewidth}{1cm}
  \item \rule{\linewidth}{2cm}
\end{multifigures}

\begin{multifigures}[columns=3,column-gap=12pt][colspec={X[c]}]
  \examzhtestmultifigureswidth
    { \linewidth }
    {multifigures-single-item-width}
  \item A single item uses the resolved one-column width.
\end{multifigures}
\TYPE{layout-controls-rendered}

\END
