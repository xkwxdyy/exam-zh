  }
\bool_set_true:N \l__examzh_fillin_width_auto_bool
\skip_set:Nn \l_tmpa_skip
  { \__examzh_fillin_final_segment_width:n { 100pt } }
\TYPE
  {
    fillin-auto-final-segment=\skip_use:N \l_tmpa_skip
  }
\bool_set_false:N \l__examzh_fillin_width_auto_bool
\parindent=20pt
\dim_set:Nn \l_tmpa_dim { 100pt }
\par
\__examzh_fillin_adjust_paragraph_start_width:N \l_tmpa_dim
\TYPE { fillin-paragraph-start-width=\dim_use:N \l_tmpa_dim }
\par\noindent
\dim_set:Nn \l_tmpa_dim { 100pt }
\__examzh_fillin_adjust_paragraph_start_width:N \l_tmpa_dim
\TYPE { fillin-noindent-width=\dim_use:N \l_tmpa_dim }
\par

\cs_set_eq:NN
  \__examzh_test_fillin_output_breakable_F:
  \__examzh_fillin_output_breakable_F:
\cs_set_protected:Npn \__examzh_fillin_output_breakable_F:
  {
    \dim_compare:nNnTF
      { \l__examzh_fillin_following_punctuation_width_dim } > { 0pt }
      { \TYPE { fillin-punctuation-reserve=yes } }
      { \TYPE { fillin-punctuation-reserve=no } }
  }

