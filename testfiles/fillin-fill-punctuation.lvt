\ExplSyntaxOn
\dim_set:Nn \l__examzh_fillin_following_punctuation_width_dim { 10pt }
\bool_set_true:N \l__examzh_fillin_width_fill_bool
\TYPE
  {
    fillin-fill-segment-width=
    \dim_eval:n { \__examzh_fillin_full_segment_width:n { 100pt } }
  }
\bool_set_false:N \l__examzh_fillin_width_fill_bool
\TYPE
  {
    fillin-normal-segment-width=
