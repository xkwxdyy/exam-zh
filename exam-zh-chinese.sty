\cs_new_protected:Npn \__examzh_composition_grid_prepare_cell_format:
  {
    \tl_if_empty:NTF \l__examzh_composition_grid_cell_format_tl
      {
        \tl_if_eq:VnTF \l__examzh_composition_grid_cell_size_tl { auto }
          {
            \dim_set:Nn \l__examzh_composition_grid_cell_size_dim
              {
                \fp_to_dim:n
                  {
                    \l__examzh_composition_grid_cell_scale_fp
                    * \f@size
                  }
              }
          }
          {
            \dim_set:Nn \l__examzh_composition_grid_cell_size_dim
              { \l__examzh_composition_grid_cell_size_tl }
          }
        % hanzibox adds 1pt around the base CJK glyph when sizing a frame.
        \dim_set:Nn \l__examzh_composition_grid_effective_cell_size_dim
          { \l__examzh_composition_grid_cell_size_dim - 1pt }
        \tl_set:Nx \l__examzh_composition_grid_effective_cell_format_tl
          {
            \exp_not:N \fontsize
              { \dim_use:N \l__examzh_composition_grid_effective_cell_size_dim }
              {
                \dim_eval:n
                  { 1.2 \l__examzh_composition_grid_effective_cell_size_dim }
              }
            \exp_not:N \selectfont
          }
      }
      {
        \tl_set_eq:NN \l__examzh_composition_grid_effective_cell_format_tl
          \l__examzh_composition_grid_cell_format_tl
      }
  }

\cs_new_protected:Npn \__examzh_composition_grid_prepare_options:
  {
    \__examzh_composition_grid_prepare_cell_format:
    \tl_set:Nx \l__examzh_composition_grid_options_tl
      {
        gridcols       = \l__examzh_composition_grid_columns_int,
        gridsepv       = \l__examzh_composition_grid_row_sep_ratio_tl,
        frametype      = \l__examzh_composition_grid_frame_type_tl,
        framecolor     = \l__examzh_composition_grid_frame_color_tl,
        fillcolor      = \l__examzh_composition_grid_fill_color_tl,
        charf          =
          { \exp_not:V \l__examzh_composition_grid_effective_cell_format_tl },
        framelinewidth = \l__examzh_composition_grid_frame_linewidth_dim
      }
    \tl_if_empty:NF \l__examzh_composition_grid_hanzibox_options_tl
      {
        \tl_put_right:Nn \l__examzh_composition_grid_options_tl { , }
        \tl_put_right:NV \l__examzh_composition_grid_options_tl
          \l__examzh_composition_grid_hanzibox_options_tl
      }
  }

\cs_new_protected:Npn \__examzh_composition_grid_write:n #1
  {
    \exp_args:NV \__examzh_composition_grid:nn
      \l__examzh_composition_grid_options_tl {#1}
  }

\cs_new_protected:Npn \__examzh_composition_grid_measure:
  {
    \hbox_set:Nn \l__examzh_composition_grid_one_row_box
      { \__examzh_composition_grid_write:n {1} }
    \hbox_set:Nn \l__examzh_composition_grid_two_rows_box
      { \__examzh_composition_grid_write:n {2} }
    \dim_set:Nn \l__examzh_composition_grid_first_row_height_dim
      {
        \box_ht:N \l__examzh_composition_grid_one_row_box
        + \box_dp:N \l__examzh_composition_grid_one_row_box
      }
    \dim_set:Nn \l__examzh_composition_grid_row_stride_dim
      {
        \box_ht:N \l__examzh_composition_grid_two_rows_box
        + \box_dp:N \l__examzh_composition_grid_two_rows_box
        - \l__examzh_composition_grid_first_row_height_dim
      }
  }

\cs_new_protected:Npn \__examzh_composition_grid_set_rows_fit:
  {
    \dim_compare:nNnTF { \pagegoal } > { 10000pt }
      {
        \dim_set_eq:NN \l__examzh_composition_grid_available_height_dim
          \textheight
      }
      {
        \dim_set:Nn \l__examzh_composition_grid_available_height_dim
          { \pagegoal - \pagetotal }
      }
    % Leave a small tolerance for page-builder rounding and the outer rule.
    \dim_sub:Nn \l__examzh_composition_grid_available_height_dim { 1pt }
    \dim_compare:nNnTF
      { \l__examzh_composition_grid_available_height_dim }
      < { \l__examzh_composition_grid_first_row_height_dim }
      { \int_zero:N \l__examzh_composition_grid_rows_fit_int }
      {
        \int_set:Nn \l__examzh_composition_grid_rows_fit_int
          {
            1 + \int_div_truncate:nn
              {
                \dim_to_decimal_in_sp:n
                  {
                    \l__examzh_composition_grid_available_height_dim
                    - \l__examzh_composition_grid_first_row_height_dim
                  }
              }
              { \dim_to_decimal_in_sp:n { \l__examzh_composition_grid_row_stride_dim } }
          }
      }
  }

\prg_new_conditional:Npnn \__examzh_composition_grid_mark_valid:n #1 { T }
  {
    \int_set:Nn \l__examzh_composition_grid_mark_int {#1}
    \bool_lazy_all:nTF
      {
        { \int_compare_p:n { \l__examzh_composition_grid_mark_int > 0 } }
        {
          \int_compare_p:n
            {
              \int_mod:nn
                { \l__examzh_composition_grid_mark_int }
                { \l__examzh_composition_grid_columns_int }
              = 0
            }
        }
        {
          \int_compare_p:n
            {
              \l__examzh_composition_grid_mark_int
              <= \l__examzh_composition_grid_rows_int
                 * \l__examzh_composition_grid_columns_int
            }
        }
      }
      { \prg_return_true: }
      {
        \msg_warning:nnn { exam-zh / chinese }
          { composition-grid-invalid-mark } {#1}
        \prg_return_false:
      }
  }

\cs_new_protected:Npn \__examzh_composition_grid_mark:nn #1#2
  {
    \__examzh_composition_grid_mark_valid:nT {#2}
      {
        \int_set:Nn \l_tmpa_int
          {
            \int_div_truncate:nn
              { \l__examzh_composition_grid_mark_int }
              { \l__examzh_composition_grid_columns_int }
          }
        \bool_lazy_and:nnT
          { \int_compare_p:n { \l_tmpa_int > #1 } }
          {
            \int_compare_p:n
              {
                \l_tmpa_int
                <= #1 + \l__examzh_composition_grid_chunk_rows_int
              }
          }
          {
            \dim_set:Nn \l__examzh_composition_grid_mark_raise_dim
              {
                -\box_dp:N \l__examzh_composition_grid_chunk_box
                + \int_eval:n
                    {
                      #1 + \l__examzh_composition_grid_chunk_rows_int
                      - \l_tmpa_int
                    }
                  \l__examzh_composition_grid_row_stride_dim
                + 0.6pt
              }
            \hbox_overlap_right:n
              {
                \skip_horizontal:n
                  {
                    \box_wd:N \l__examzh_composition_grid_chunk_box
                    + \l__examzh_composition_grid_count_sep_dim
                  }
                \smash
                  {
                    \raisebox
                      { \l__examzh_composition_grid_mark_raise_dim }
                      { \tl_use:N \l__examzh_composition_grid_count_format_tl #2 }
                  }
              }
          }
      }
  }

\cs_new_protected:Npn \__examzh_composition_grid_typeset_chunk:nn #1#2
  {
    \int_set:Nn \l__examzh_composition_grid_chunk_rows_int {#2}
    \hbox_set:Nn \l__examzh_composition_grid_chunk_box
      { \__examzh_composition_grid_write:n {#2} }
    \nointerlineskip
    \hbox:n
      {
        \clist_map_inline:Nn \l__examzh_composition_grid_count_marks_clist
          { \__examzh_composition_grid_mark:nn {#1} {##1} }
        \box_use_drop:N \l__examzh_composition_grid_chunk_box
      }
  }

\cs_new_protected:Npn \__examzh_composition_grid_typeset_auto:
  {
    \__examzh_composition_grid_measure:
    \int_zero:N \l__examzh_composition_grid_rows_done_int
    \int_while_do:nn
      { \l__examzh_composition_grid_rows_done_int < \l__examzh_composition_grid_rows_int }
      {
        \__examzh_composition_grid_set_rows_fit:
        \int_compare:nNnT { \l__examzh_composition_grid_rows_fit_int } = {0}
          {
            \newpage
            \__examzh_composition_grid_set_rows_fit:
          }
        \int_compare:nNnTF { \l__examzh_composition_grid_rows_fit_int } = {0}
          {
            \msg_error:nn { exam-zh / chinese }
              { composition-grid-row-too-tall }
            \int_set_eq:NN \l__examzh_composition_grid_rows_done_int
              \l__examzh_composition_grid_rows_int
          }
          {
            \int_set:Nn \l__examzh_composition_grid_chunk_rows_int
              {
                \int_min:nn
                  { \l__examzh_composition_grid_rows_fit_int }
                  {
                    \l__examzh_composition_grid_rows_int
                    - \l__examzh_composition_grid_rows_done_int
                  }
              }
            \__examzh_composition_grid_typeset_chunk:nn
              { \l__examzh_composition_grid_rows_done_int }
              { \l__examzh_composition_grid_chunk_rows_int }
            \int_add:Nn \l__examzh_composition_grid_rows_done_int
              { \l__examzh_composition_grid_chunk_rows_int }
            \int_compare:nNnT
              { \l__examzh_composition_grid_rows_done_int }
              < { \l__examzh_composition_grid_rows_int }
              { \newpage }
          }
      }
  }

\NewDocumentCommand \compositiongrid { O{ } m }
  {
    \group_begin:
      \keys_set:nn { exam-zh / composition-grid } {#1}
      \int_set:Nn \l__examzh_composition_grid_target_count_int {#2}
      \int_compare:nNnTF
        { \l__examzh_composition_grid_target_count_int } > {0}
        {
          \int_compare:nNnTF
            { \l__examzh_composition_grid_columns_int } > {0}
            {
              \int_set:Nn \l__examzh_composition_grid_rows_int
                {
                  \int_div_truncate:nn
                    {
                      \l__examzh_composition_grid_target_count_int
                      + \l__examzh_composition_grid_columns_int - 1
                    }
                    { \l__examzh_composition_grid_columns_int }
                }
              \__examzh_composition_grid_prepare_options:
              \par\addvspace{\medskipamount}
              \bool_if:NTF \l__examzh_composition_grid_auto_break_bool
                { \__examzh_composition_grid_typeset_auto: }
                {
                  \__examzh_composition_grid_measure:
                  \__examzh_composition_grid_typeset_chunk:nn
                    {0} { \l__examzh_composition_grid_rows_int }
                }
            }
            {
              \msg_error:nn { exam-zh / chinese }
                { composition-grid-invalid-columns }
            }
        }
        {
          \msg_error:nn { exam-zh / chinese }
            { composition-grid-invalid-target }
        }
    \group_end:
  }

