  "changes": [
    {
      "id": "release-dashboard-completed-state",
      "type": "fixed",
      "zh": "修复发布链续跑成功后仍显示旧失败步骤和继续按钮的问题，以同一版本的最新成功任务终结旧 checkpoint 并显示完成状态。",
      "announce": false
    },
    {
      "id": "release-dashboard-context-layout",
      "type": "fixed",
      "zh": "修复发布参数区域的桌面端网格留白，将跳过编译开关并入参数行，并在窄屏上保持整行布局。",
      "announce": false
    },
    {
      "id": "release-dashboard-next-context",
      "type": "fixed",
      "zh": "发布链完整成功后，Dashboard 下次打开会自动切换到下一补丁版本、当天日期和匹配的提交信息，同时继续保留未完成任务的原参数以供恢复。",
      "announce": false
    },
    {
      "id": "fillin-auto-captured-unit-wrap",
      "type": "fixed",
      "zh": "修复隐藏答案时 `fillin/width=auto` 的短填空与后续标点在行尾可能拒绝换行并越出版心的问题（GitHub #52）。",
      "announce": false
    },
    {
      "id": "choices-margin-every-row",
      "type": "fixed",
      "zh": "修复 `choices/margin` 在多行选项中仅缩进首行的问题，使后续选项行使用相同的左右边距（GitHub #47）。",
      "announce": false
    },
    {
      "id": "linegoal-xetex-convergence",
      "type": "fixed",
      "zh": "稳定 XeTeX 下 `linegoal` 的横坐标记录，避免 `fillin/width=auto` 因 1sp 级位置波动导致 `latexmk` 多轮编译无法收敛（GitHub #51）。",
      "announce": false
    },
    {
      "id": "choices-inline-verb",
      "type": "fixed",
      "zh": "修复 GitHub #30 原始复现中 `choices` 的常规内联 `\\verb` 选项无法编译的问题。",
      "announce": false
    }
  ]
